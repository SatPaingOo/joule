# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
*.pyc

# ---- Tooling / caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hf_cache/
*.log

# ---- Models (large, user-downloaded; NOT committed) ----
# Users run `joule convert <path>` themselves — see docs/USAGE.md §0.
models/
*.gguf
*.safetensors

# ---- Runtime artifacts (generated by joule convert / serve) ----
# Q4/i8/bf16 expert stores, fixed-weight .npy caches, probes — all
# regenerable with `joule convert`; committed would bloat the repo.
storage/converted/
storage/*.bin
storage/*.json

# ---- Results / experiments ----
# VALIDATION_LOG.md + proto JSONs ARE committed (the evidence base for the
# docs). Only stray artifacts are ignored.
results/*.bak
results/*.tmp

# ---- Env / secrets ----
.env
HF_TOKEN
*.pem
*.key

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- Zig build dirs (DLLs ARE committed — users run without zig) ----
zig-cache/
zig-out/

# ---- Native build artifacts (only the .dll/.c/.h are committed) ----
*.lib
*.pdb
*.obj
*.o
*.exp

# ---- Archive (historical experiments, not needed to run) ----
archive/

# ---- Serve response dumps (runtime artifacts) ----
resp*.json

# ---- llama.cpp tools (baseline comparison only, not needed to run Joule) ----
tools/
